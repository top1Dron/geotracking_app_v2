# --------------------------------------------------
# FastAPI app settings
# --------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
DEBUGPY_ENABLED=true
DEBUGPY_PORT=5678

# --------------------------------------------------
# Database containers (Postgres + PgBouncer)
# --------------------------------------------------
POSTGRES_DB=geotracking
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# --------------------------------------------------
# PgBouncer settings (edoburu/pgbouncer)
# --------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=geotracking
POOL_MODE=transaction
DEFAULT_POOL_SIZE=20
MAX_CLIENT_CONN=200

# --------------------------------------------------
# App database connection URLs
# --------------------------------------------------
DATABASE_URL=postgresql+asyncpg://app:app@pgbouncer:5432/geotracking
DATABASE_URL_DIRECT=postgresql+asyncpg://app:app@db:5432/geotracking

# --------------------------------------------------
# Redis connection
# --------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --------------------------------------------------
# SQLAlchemy pool tuning
# --------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
DB_STATEMENT_CACHE_SIZE=0

# --------------------------------------------------
# Stream/channel settings
# --------------------------------------------------
INGEST_CHANNEL=locations.ingest
LOCATIONS_CHANNEL=locations
ALERTS_CHANNEL=alerts
INGEST_CONCURRENCY=30
LOCATION_MAX_AGE_SECONDS=60
WS_LOCATION_MIN_INTERVAL_MS=250
